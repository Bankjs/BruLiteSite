# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
AUTH_SECRET= # openssl rand -base64 32

# --- Database (Neon) ---
DATABASE_URL=postgresql://user:pass@host/dbname?sslmode=require

# --- Discord OAuth ---
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# --- Discord Bot (see docs/discord-setup.md) ---
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_CUSTOMER_ROLE_ID=
DISCORD_ADMIN_ROLE_IDS= # comma-separated role IDs
DISCORD_TICKETS_WEBHOOK_URL= # channel webhook for new tickets

# --- Stripe ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# --- Vercel Blob (client download hosting) ---
BLOB_READ_WRITE_TOKEN=

# --- Terms version; bump to re-prompt acceptance ---
TERMS_VERSION=1
