# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
AUTH_SECRET=

# --- Database (Neon) ---
DATABASE_URL=postgresql://user:pass@host/dbname?sslmode=require

# --- Discord OAuth ---
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# --- Discord Bot (see docs/discord-setup.md) ---
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_CUSTOMER_ROLE_ID=
DISCORD_ADMIN_ROLE_IDS= # comma-separated role IDs
# Tickets → Discord. Preferred: a forum channel (each ticket = a thread).
DISCORD_TICKETS_FORUM_ID=
DISCORD_TICKETS_TAG_BUG=      # optional forum tag IDs
DISCORD_TICKETS_TAG_FEATURE=
# Fallback: plain channel webhook (used when no forum ID is set)
DISCORD_TICKETS_WEBHOOK_URL=

# --- Stripe ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# --- Vercel Blob (client download hosting) ---
BLOB_READ_WRITE_TOKEN=

# --- Terms version; bump to re-prompt acceptance ---
TERMS_VERSION=1
